# Maintainer: ifsvivek
# The one place that names the app package (crates/app, binary `nocturne`; installed name is always `nocturne`).
_pkg=${_pkg:-nocturne-app}
_bin=${_bin:-nocturne}
pkgname=nocturne
pkgver=0.5.2
pkgrel=1
pkgdesc='Native Jellyfin desktop client with libmpv playback, Wayland first'
arch=(x86_64)
url='https://github.com/ifsvivek/nocturne'
license=(GPL-3.0-or-later)
# Runtime list derived from `readelf -d` of the release binary plus dlopen'd libraries (see docs/PACKAGING.md).
# Only libdbus-1, glibc and libgcc_s are linked; libmpv.so.2, libvulkan.so.1, libEGL.so.1, libwayland-client.so.0,
# libwayland-egl.so.1 and libxkbcommon are dlopen'd, so namcap
# cannot infer them: they stay listed explicitly on purpose. No fontconfig/freetype (cosmic-text parses fonts.conf itself).
depends=(
  dbus gcc-libs glibc libglvnd libxkbcommon
  systemd-libs # libudev.so.1, linked by the gamepad input (gilrs)
  mpv          # provides libmpv.so.2 (loaded at run time) and the `mpv` binary used as the fallback player
  vulkan-icd-loader vulkan-driver wayland
)
optdepends=('gnome-keyring: Secret Service provider for storing the login token (or kwallet / KeePassXC)'
            'xdg-desktop-portal: folder picker for local libraries'
            'noto-fonts: the UI font (Noto Sans); falls back to any system sans')
options=(!lto) # aws-lc-sys C objects built with -flto cannot be linked by rustc
makedepends=(cargo pkgconf) # libmpv is no longer linked at build time
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('83ca11d882fa4989c9d80f8df8f967af2778aec69b96911b170597935adae4f5')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  export RUSTFLAGS="$RUSTFLAGS --remap-path-prefix=$HOME=/home/build --remap-path-prefix=$PWD=/src"
  cargo build --frozen --release -p "$_pkg"
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen --workspace
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/$_bin" "$pkgdir/usr/bin/nocturne"
  install -Dm644 packaging/io.github.ifsvivek.nocturne.desktop -t "$pkgdir/usr/share/applications"
  for s in 48 128 256 512; do
    install -Dm644 "packaging/icons/nocturne-$s.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/nocturne.png"
  done
  install -Dm644 packaging/nocturne.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 packaging/*.metainfo.xml -t "$pkgdir/usr/share/metainfo"
  install -Dm644 LICENSE THIRD_PARTY_NOTICES.md -t "$pkgdir/usr/share/licenses/$pkgname"
}
