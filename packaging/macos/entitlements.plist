<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened runtime (needed for notarisation). The bundled mpv/ffmpeg dylibs are signed with the same identity,
     so library validation can stay on; if a Homebrew dylib is signed by someone else, add
     com.apple.security.cs.disable-library-validation here. Used only by the optional signing step. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.network.client</key><true/>
</dict>
</plist>
