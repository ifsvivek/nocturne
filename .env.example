# Template for the git-ignored .env (loaded from the working directory or an ancestor).
# Developer mode: skips sign-in and is strictly read-only. Use a Jellyfin API key, never commit a real value.
NOCTURNE_JF_URL=http://127.0.0.1:8096
NOCTURNE_JF_TOKEN=

# Optional, for live tests of 0.4 online features (your own accounts; leave empty otherwise)
NOCTURNE_TMDB_KEY=
NOCTURNE_OPENSUBTITLES_KEY=
NOCTURNE_OPENSUBTITLES_USER=
NOCTURNE_OPENSUBTITLES_PASSWORD=
NOCTURNE_TRAKT_CLIENT_ID=
NOCTURNE_TRAKT_CLIENT_SECRET=
