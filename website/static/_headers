/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; manifest-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/_app/immutable/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Package repository (static/repo/, generated at deploy). Rules run in file order, so each detaches the global
# Cache-Control above and sets its own; no-transform stays so nothing re-encodes signed files. CSP and the other
# global headers are harmless on downloads.
/repo/ARCH-GPG-KEY
  ! Cache-Control
  Cache-Control: no-cache, no-transform

/repo/*.db
  ! Cache-Control
  Cache-Control: no-cache, no-transform

/repo/*.db.sig
  ! Cache-Control
  Cache-Control: no-cache, no-transform

/repo/*.files
  ! Cache-Control
  Cache-Control: no-cache, no-transform

/repo/*.files.sig
  ! Cache-Control
  Cache-Control: no-cache, no-transform

/repo/*.pkg.tar.zst
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable, no-transform

/repo/*.pkg.tar.zst.sig
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable, no-transform
